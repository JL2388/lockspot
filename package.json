{
  "name": "fuel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,api -c blue,magenta \"next dev\" \"wrangler pages dev public --port 8788 --show-interactive-dev-session=false\"",
    "build": "next build",
    "start": "wrangler pages dev ./out --port 8788",
    "lint": "eslint",
    "build:data": "tsx --env-file-if-exists=.env.local scripts/build-data.ts",
    "verify:data": "tsx scripts/verify-data.ts",
    "test": "vitest run",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "preview": "npm run build && wrangler pages dev ./out --port 8788",
    "deploy": "npm run build && wrangler pages deploy --commit-dirty=true",
    "check": "tsc --noEmit && tsc -p functions/tsconfig.json && eslint && vitest run"
  },
  "dependencies": {
    "maplibre-gl": "^6.13.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
